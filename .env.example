# Servidor local
PORT=3000
HOST=0.0.0.0

# URL publica final, sem barra no fim.
# Na Vercel, use o dominio de producao (ex.: https://patinhasfelizes.vercel.app).
PUBLIC_BASE_URL=

# Neon PostgreSQL.
# Prefira a connection string POOLER do Neon (host contendo -pooler).
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-POOLER/neondb?sslmode=require
DB_POOL_MAX=3

# Segredo usado para autorizar uploads anonimos do formulario.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPLOAD_SIGNING_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres
UPLOAD_TICKET_MINUTOS=30

# Dados do negocio
PIX_KEY=(14) 99720-0278
OWNER_WHATSAPP=5514991937562
VALIDATION_PIN=2468
EXPIRACAO_VALIDACAO_HORAS=72

# Vercel Blob Private
# Em producao, conecte o Blob ao projeto pela aba Storage da Vercel.
# O fluxo de client upload deste projeto precisa de BLOB_READ_WRITE_TOKEN
# somente no servidor para emitir tokens temporarios de upload.
# Para desenvolvimento local, inclua Development na conexao e use
# `vercel env pull .env.local`. Nunca exponha esse token no frontend/Git.
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
